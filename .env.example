DATABASE_URL=postgresql://tcc_owner:change_me@localhost:5433/tccsql
READONLY_DATABASE_URL=postgresql://tcc_reader:change_me@localhost:5433/tccsql

# Provedor LLM.
# - fake: provedor determinístico embutido, usado nos testes automatizados.
# - openai: usa o OpenAICompatibleProvider para qualquer endpoint no padrão OpenAI
#   (OpenAI, Groq, Ollama local, etc.). Preencha OPENAI_API_KEY, OPENAI_BASE_URL e LLM_MODEL.
LLM_PROVIDER=fake
LLM_MODEL=fake-deterministic-v1

# --- Groq (plano gratuito, recomendado para o experimento) ---
# 1. Crie uma conta e gere a key em https://console.groq.com/keys
# 2. Troque LLM_PROVIDER=openai, LLM_MODEL para um modelo do catálogo,
#    e preencha as duas variáveis abaixo.
# Catálogo atualizado: https://console.groq.com/docs/models
# Sugestões (verificadas em 14/11/2026): openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

EXPERIMENT_VERSION=1.0.0
CANDIDATES_ROOT=C:\\Users\\Yuri\\rt_data\\genericos
