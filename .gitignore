# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.venv/
venv/

# Configuração local e segredos
.env
.env.*
!.env.example

# Artefatos produzidos pelas execuções
# raw/ contem registros brutos com SQL gerado — fica local
artifacts/raw/*
!artifacts/raw/.gitkeep
# processed/ e reports/ sao agregados sem valores de linha — versionaveis
!artifacts/processed/*.csv
!artifacts/reports/*.md

# Dados locais de origem
data/raw/
*.xlsx
*.xls

# Saída da compilação local da monografia
monografia/build/

# Editores e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
